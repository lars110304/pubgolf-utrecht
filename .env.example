# Copy this file to .env and fill in the values. .env is git-ignored.

# Database: mysql (default) or sqlite (handy for testing on your own computer)
DB_DRIVER=mysql

# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Only for DB_DRIVER=sqlite. Relative paths start from the folder that holds this file.
DB_PATH=

# Name of this game. Use a different value to keep a separate scorecard in the same database.
GAME_ID=pubgolf-utrecht
